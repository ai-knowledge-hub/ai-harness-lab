---
import { ChatGPTAdsArchitecture } from "../../src/components/ChatGPTAdsArchitecture";
import { architectureStages, deliveryExamples } from "../../src/content/chatgpt-ad-architecture";

interface Props { id: string }
const { id } = Astro.props;
---

<div data-ads-walkthrough>
  <ChatGPTAdsArchitecture id={id} staticEnhancement />
  <template data-controls>
    <div class="ads-controls">
      <ol class="ads-stage-picker" aria-label="Architecture stages">
        {architectureStages.map((stage, index) => (
          <li>
            <button type="button" data-stage={index}
              aria-label={`Stage ${index + 1}: ${stage.title}`}
              aria-controls={`${id}-map ${id}-explanations`}>
              <span aria-hidden="true">0{index + 1}</span>{stage.short}
            </button>
          </li>
        ))}
      </ol>
      <div class="ads-step-actions">
        <button type="button" data-previous>Previous</button>
        <p role="status"></p>
        <button type="button" data-next>Next</button>
      </div>
      <button type="button" class="ads-complete-toggle" aria-pressed="false">Show complete diagram</button>
    </div>
  </template>
  <template data-delivery-controls>
    <div>
      <label for={`${id}-example`}>Example ad outcome</label>
      <select id={`${id}-example`}>
        {Object.entries(deliveryExamples).map(([value, item]) => <option value={value}>{item.label}</option>)}
      </select>
      <p role="status"></p>
    </div>
  </template>
</div>
