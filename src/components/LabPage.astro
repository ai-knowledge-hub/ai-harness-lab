---
import SiteLayout from "../layouts/SiteLayout.astro";
import AlgorithmLabIsland from "./AlgorithmLabIsland";
import { labPath } from "../content/site";
import BinarySearchContext from "../content/labs/binary-search.mdx";
import "../styles/binary-search.css";
interface Props { legacy?: boolean }
const { legacy = false } = Astro.props;
---
<SiteLayout path={labPath} redirectTo={legacy ? labPath : undefined} noindex={legacy}>
  <AlgorithmLabIsland client:load><BinarySearchContext /></AlgorithmLabIsland>
</SiteLayout>
