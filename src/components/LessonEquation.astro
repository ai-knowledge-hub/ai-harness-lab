---
interface Props { kind: "contribution" | "ranking" | "threshold" | "lift" }
const { kind } = Astro.props;
const labels = { contribution: "0.05 times 60 pounds equals 3 pounds", ranking: "Score i equals bid i times quality i", threshold: "Threshold bid equals 1.50 divided by 0.9, approximately 1.67 pounds", lift: "3.0 percent minus 2.5 percent equals 0.5 percentage points" };
// Astro treats MathML child text literally. These trusted repository constants
// supply native MathML without exposing template expressions as equation text.
const markup = {
  contribution: "<mrow><mn>0.05</mn><mo>×</mo><mn>£60</mn><mo>=</mo><mn>£3</mn></mrow>",
  ranking: "<mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><msub><mi>b</mi><mi>i</mi></msub><msub><mi>q</mi><mi>i</mi></msub></mrow>",
  threshold: "<mrow><msub><mi>b</mi><mtext>threshold</mtext></msub><mo>=</mo><mfrac><mn>1.50</mn><mn>0.9</mn></mfrac><mo>≈</mo><mn>£1.67</mn></mrow>",
  lift: "<mrow><mn>3.0</mn><mo>%</mo><mo>−</mo><mn>2.5</mn><mo>%</mo><mo>=</mo><mn>0.5</mn><mtext>&#160;percentage points</mtext></mrow>",
};
---
<div class="lesson-equation" data-equation={kind} role="region" aria-label={`Equation: ${labels[kind]}`} tabindex="0">
  <math display="block" aria-label={labels[kind]} set:html={markup[kind]} />
</div>
