{
  "buildCommand": "pnpm build:deployment",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "framework": "astro",
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/learn/system-design/chatgpt-ads-apis",
      "destination": "/learn/system-design/chatgpt-ads#advertiser-controls",
      "permanent": true
    },
    {
      "source": "/learn/system-design/chatgpt-ads-apis/",
      "destination": "/learn/system-design/chatgpt-ads#advertiser-controls",
      "permanent": true
    },
    {
      "source": "/learn/system-design/chatgpt-ads-apis.html",
      "destination": "/learn/system-design/chatgpt-ads#advertiser-controls",
      "permanent": true
    }
  ]
}
