{
  "name": "ai-harness-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "build:astro-pilot": "astro build --config astro.pilot.config.mjs",
    "preview:astro-pilot": "astro preview --config astro.pilot.config.mjs",
    "test:astro-pilot": "pnpm build:astro-pilot && playwright test --config playwright.pilot.config.js",
    "build:deployment": "pnpm build && node scripts/stage-astro-pilot.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test:run && pnpm build"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@astrojs/react": "5.0.7",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "19.2",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "6.4.8",
    "jsdom": "^26.1.0",
    "typescript": "6.0.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "zod": "4.6.7"
  }
}
