{
  "name": "ai-harness-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-reference-contracts.mjs && astro build",
    "preview": "astro preview",
    "build:astro-page": "pnpm build",
    "build:astro-pilot": "pnpm build",
    "preview:astro-pilot": "pnpm preview",
    "test:astro-pilot": "pnpm build && playwright test --config playwright.pilot.config.js && pnpm test:e2e",
    "build:deployment": "node scripts/stage-astro-pilot.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:site": "playwright test --config playwright.site.config.js",
    "check:routes": "node scripts/check-astro-output.mjs",
    "check:authoring": "node scripts/check-astro-authoring.mjs",
    "typecheck": "astro sync && astro check",
    "check": "pnpm typecheck && pnpm test:run && pnpm build",
    "build:legacy": "node scripts/build.mjs",
    "preview:legacy": "vite preview --outDir legacy-dist"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/react": "5.0.7",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@playwright/test": "1.59.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22",
    "@types/react": "19.2",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "6.4.8",
    "jsdom": "^26.1.0",
    "typescript": "6.0.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.6",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
